# IONOS-KI / IONOS 7
# Copy to .env locally or add the required values in Render Environment.
# Never commit real secrets. Blank values are intentional placeholders.

# Required application security
SECRET_KEY=

# AI provider (configure at least one API key)
AI_PROVIDER=openai
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional AI capability
ENABLE_WEB_SEARCH=true

# Database: leave blank to use the application's SQLite fallback.
DATABASE_URL=

# Required only for authenticated calls from the Ultima agent bridge.
ULTIMA_AGENT_SHARED_TOKEN=

